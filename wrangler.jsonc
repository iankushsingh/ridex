{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./rydex/.open-next/worker.js",
	"name": "ridex",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./rydex/.open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ridex"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
